{{- $stored := eq (option "store-key") "true" -}}
//go:build unit

package apiclient_test

import (
	"crypto/sha256"
	"encoding/hex"
	"io"
	"net/http"
	"net/http/httptest"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"testing"

	"{{ option "starter.module" }}/internal/apiclient"
	"{{ option "starter.module" }}/internal/auth"
	"{{ option "starter.module" }}/internal/credential"
	"github.com/stretchr/testify/require"
)

const (
	variable = "{{ upper (snake .Name) }}_API_KEY"
	knownKey = "known-key-of-the-test"
	otherKey = "other-known-key-of-the-test"
)

type api struct {
	url            string
	requests       int
	authorizations [][]string
}

func startedAPI(t *testing.T) *api {
	t.Helper()
	var cfg auth.Config
	require.NoError(t, cfg.KeyHashes.UnmarshalText([]byte(hashOf(knownKey)+","+hashOf(otherKey))))
	started := &api{}
	protected := auth.Middleware(cfg)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		started.authorizations = append(started.authorizations, r.Header.Values("Authorization"))
		status, err := strconv.Atoi(strings.TrimPrefix(r.URL.Path, "/status/"))
		if err != nil {
			status = http.StatusOK
		}
		w.WriteHeader(status)
		_, _ = io.WriteString(w, "the answer of the handler")
	}))
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		started.requests++
		protected.ServeHTTP(w, r)
	}))
	t.Cleanup(server.Close)
	started.url = server.URL
	return started
}

func hashOf(key string) string {
	sum := sha256.Sum256([]byte(key))
	return hex.EncodeToString(sum[:])
}

func isolate(t *testing.T) string {
	t.Helper()
	home := t.TempDir()
	t.Setenv("XDG_CONFIG_HOME", home)
	t.Setenv(variable, "")
{{- if $stored }}
	t.Setenv("{{ upper (snake .Name) }}_API_URL", "https://api.example.test")
	t.Setenv("{{ upper (snake .Name) }}_CREDENTIAL_STORE", "file")
{{- end }}
	return filepath.Join(home, "{{ kebab .Name }}")
}

func writeConfig(t *testing.T, dir, text string) string {
	t.Helper()
	require.NoError(t, os.MkdirAll(dir, 0o700))
	path := filepath.Join(dir, "config.yaml")
	require.NoError(t, os.WriteFile(path, []byte(text), 0o600))
	return path
}

func bodyOf(t *testing.T, response *http.Response) string {
	t.Helper()
	defer response.Body.Close()
	body, err := io.ReadAll(response.Body)
	require.NoError(t, err)
	return string(body)
}

func TestClient(t *testing.T) {
	t.Run("do", func(t *testing.T) {
		t.Run("with a known key from the variable, the call gets the answer of the handler, and sends the key in one Authorization header", func(t *testing.T) {
			isolate(t)
			t.Setenv(variable, knownKey)
			started := startedAPI(t)

			response, err := apiclient.New(started.url).Do(t.Context(), http.MethodPost, "/accounts", nil)

			require.NoError(t, err)
			require.Equal(t, []any{http.StatusOK, "the answer of the handler"}, []any{response.StatusCode, bodyOf(t, response)})
			require.Equal(t, [][]string{
				{"Bearer " + knownKey},
			}, started.authorizations)
		})

		t.Run("with a known key from the credentialCommand, the call gets the answer of the handler", func(t *testing.T) {
			writeConfig(t, isolate(t), "credentialCommand: echo "+knownKey+"\n")
			started := startedAPI(t)

			response, err := apiclient.New(started.url).Do(t.Context(), http.MethodGet, "/accounts/1", nil)

			require.NoError(t, err)
			require.Equal(t, http.StatusOK, response.StatusCode)
			require.Equal(t, [][]string{
				{"Bearer " + knownKey},
			}, started.authorizations)
		})

		t.Run("when XDG_CONFIG_HOME is not an absolute path, the call takes the key from the credentialCommand under .config in the home folder", func(t *testing.T) {
			isolate(t)
			home := t.TempDir()
			t.Setenv("HOME", home)
			t.Setenv("XDG_CONFIG_HOME", "relative/config")
			writeConfig(t, filepath.Join(home, ".config", "{{ kebab .Name }}"), "credentialCommand: echo "+knownKey+"\n")
			started := startedAPI(t)

			response, err := apiclient.New(started.url).Do(t.Context(), http.MethodGet, "/accounts/1", nil)

			require.NoError(t, err)
			require.Equal(t, http.StatusOK, response.StatusCode)
			require.Equal(t, [][]string{
				{"Bearer " + knownKey},
			}, started.authorizations)
		})

		t.Run("the client writes no file: after calls with the key from the credentialCommand, the config folder holds only the config file", func(t *testing.T) {
			dir := isolate(t)
			writeConfig(t, dir, "credentialCommand: echo "+knownKey+"\n")
			started := startedAPI(t)
			client := apiclient.New(started.url)

			for _, path := range []string{"/accounts/1", "/accounts/2"} {
				response, err := client.Do(t.Context(), http.MethodGet, path, nil)
				require.NoError(t, err)
				response.Body.Close()
			}

			entries, err := os.ReadDir(dir)
			require.NoError(t, err)
			var names []string
			for _, entry := range entries {
				names = append(names, entry.Name())
			}
			require.Equal(t, []string{"config.yaml"}, names)
		})

		t.Run("the client keeps no key: when the variable changes between two calls, the second call sends the new key", func(t *testing.T) {
			isolate(t)
			started := startedAPI(t)
			client := apiclient.New(started.url)

			t.Setenv(variable, knownKey)
			first, err := client.Do(t.Context(), http.MethodGet, "/accounts/1", nil)
			require.NoError(t, err)
			first.Body.Close()
			t.Setenv(variable, otherKey)
			second, err := client.Do(t.Context(), http.MethodGet, "/accounts/1", nil)
			require.NoError(t, err)
			second.Body.Close()

			require.Equal(t, [][]string{
				{"Bearer " + knownKey},
				{"Bearer " + otherKey},
			}, started.authorizations)
		})

		for _, status := range []int{http.StatusBadRequest, http.StatusForbidden, http.StatusNotFound} {
			t.Run("the answer "+strconv.Itoa(status)+" of the API goes to the caller as the API gave it", func(t *testing.T) {
				isolate(t)
				t.Setenv(variable, knownKey)
				started := startedAPI(t)

				response, err := apiclient.New(started.url).Do(t.Context(), http.MethodGet, "/status/"+strconv.Itoa(status), nil)

				require.NoError(t, err)
				require.Equal(t, []any{status, "the answer of the handler"}, []any{response.StatusCode, bodyOf(t, response)})
			})
		}

		t.Run("a key that the API does not know fails the call, and the message names the source of the key and the ways to give a key", func(t *testing.T) {
			dir := isolate(t)
			t.Setenv(variable, "a-key-that-the-api-does-not-know")
			started := startedAPI(t)

			response, err := apiclient.New(started.url).Do(t.Context(), http.MethodPost, "/accounts", nil)

			require.Nil(t, response)
			require.ErrorIs(t, err, credential.ErrRefused)
			require.ErrorContains(t, err, "the API refused the API key from "+variable)
			require.ErrorContains(t, err, "set "+variable+", or set credentialCommand in "+filepath.Join(dir, "config.yaml"))
			require.Equal(t, 1, started.requests)
			require.Empty(t, started.authorizations)
		})

		t.Run("with no home folder, a key that the API does not know still fails the call with the source of the key", func(t *testing.T) {
			isolate(t)
			t.Setenv("XDG_CONFIG_HOME", "")
			t.Setenv("HOME", "")
			t.Setenv(variable, "a-key-that-the-api-does-not-know")
			started := startedAPI(t)

			response, err := apiclient.New(started.url).Do(t.Context(), http.MethodPost, "/accounts", nil)

			require.Nil(t, response)
			require.ErrorIs(t, err, credential.ErrRefused)
			require.ErrorContains(t, err, "the API refused the API key from "+variable+": set "+variable)
		})

{{ if $stored -}}
		t.Run("a key stored for the host of the API reaches the handler, and {{ upper (snake .Name) }}_API_KEY wins over it", func(t *testing.T) {
			isolate(t)
			started := startedAPI(t)
			t.Setenv("{{ upper (snake .Name) }}_API_URL", started.url)
			store, err := credential.NewStore()
			require.NoError(t, err)
			_, err = store.Set(strings.TrimPrefix(started.url, "http://"), knownKey)
			require.NoError(t, err)
			client := apiclient.New(started.url)

			stored, err := client.Do(t.Context(), http.MethodGet, "/accounts/1", nil)
			require.NoError(t, err)
			stored.Body.Close()
			t.Setenv(variable, otherKey)
			fromVariable, err := client.Do(t.Context(), http.MethodGet, "/accounts/1", nil)
			require.NoError(t, err)
			fromVariable.Body.Close()

			require.Equal(t, [][]string{
				{"Bearer " + knownKey},
				{"Bearer " + otherKey},
			}, started.authorizations)
		})

		t.Run("a stored key that the API does not know fails the call, and the message names the source of the key and auth login", func(t *testing.T) {
			dir := isolate(t)
			started := startedAPI(t)
			t.Setenv("{{ upper (snake .Name) }}_API_URL", started.url)
			store, err := credential.NewStore()
			require.NoError(t, err)
			_, err = store.Set(strings.TrimPrefix(started.url, "http://"), "a-key-that-the-api-does-not-know")
			require.NoError(t, err)

			response, err := apiclient.New(started.url).Do(t.Context(), http.MethodPost, "/accounts", nil)

			require.Nil(t, response)
			require.ErrorIs(t, err, credential.ErrRefused)
			require.ErrorContains(t, err, "the API refused the API key from "+filepath.Join(dir, "credentials.json")+`: run "{{ kebab .Name }} auth login"`)
		})

{{ end -}}
		t.Run("with no key, the call fails before a request reaches the API, and the error says how to give the key", func(t *testing.T) {
			isolate(t)
			started := startedAPI(t)

			_, err := apiclient.New(started.url).Do(t.Context(), http.MethodPost, "/accounts", nil)

			require.ErrorIs(t, err, credential.ErrMissing)
			require.ErrorContains(t, err, variable)
			require.ErrorContains(t, err, "credentialCommand")
			require.Equal(t, 0, started.requests)
		})
	})
}
