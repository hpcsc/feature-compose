{{- $stored := eq (option "store-key") "true" -}}
package credential

import (
	"context"
	"errors"
	"fmt"
	"os"
)

const (
	name                = "{{ kebab .Name }}"
	environmentVariable = "{{ upper (snake .Name) }}_API_KEY"
)

var (
	ErrMissing = errors.New("no API key")
	ErrRefused = errors.New("the API refused the API key")
)

type Credential struct {
	Value  string
	Source string
}

func Resolve(ctx context.Context) (Credential, error) {
	if value := os.Getenv(environmentVariable); value != "" {
		return Credential{Value: value, Source: environmentVariable}, nil
	}
{{- if $stored }}
	stored, err := storedKey()
	if err == nil {
		return stored, nil
	}
	if !errors.Is(err, ErrNotStored) {
		return Credential{}, err
	}
{{- end }}
	path, err := configPath()
	if err != nil {
		return Credential{}, err
	}
	command, err := credentialCommand(path)
	if err != nil {
		return Credential{}, err
	}
	if command != "" {
		return runCommand(ctx, command, path)
	}
	{{- if $stored }}
	return Credential{}, fmt.Errorf(`%w: run "%s auth login", set %s, or set credentialCommand in %s`, ErrMissing, name, environmentVariable, path)
}

func storedKey() (Credential, error) {
	host, err := APIHost()
	if err != nil {
		return Credential{}, err
	}
	store, err := NewStore()
	if err != nil {
		return Credential{}, err
	}
	return store.Get(host)
	{{- else }}
	return Credential{}, fmt.Errorf(`%w: set %s, or set credentialCommand in %s`, ErrMissing, environmentVariable, path)
	{{- end }}
}

func (c Credential) Refused() error {
	path, err := configPath()
	if err != nil {
		return fmt.Errorf(`%w from %s: set %s to a key that the API knows`, ErrRefused, c.Source, environmentVariable)
	}
	{{- if $stored }}
	return fmt.Errorf(`%w from %s: run "%s auth login", set %s, or set credentialCommand in %s, to a key that the API knows`, ErrRefused, c.Source, name, environmentVariable, path)
	{{- else }}
	return fmt.Errorf(`%w from %s: set %s, or set credentialCommand in %s, to a key that the API knows`, ErrRefused, c.Source, environmentVariable, path)
	{{- end }}
}
