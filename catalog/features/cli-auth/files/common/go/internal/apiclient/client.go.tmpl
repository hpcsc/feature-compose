package apiclient

import (
	"context"
	"fmt"
	"io"
	"net/http"
	"time"

	"{{ option "starter.module" }}/internal/credential"
)

type Client struct {
	baseURL string
	http    *http.Client
}

func New(baseURL string) *Client {
	return &Client{baseURL: baseURL, http: &http.Client{Timeout: 30 * time.Second}}
}

func (c *Client) Do(ctx context.Context, method, path string, body io.Reader) (*http.Response, error) {
	found, err := credential.Resolve(ctx)
	if err != nil {
		return nil, err
	}
	request, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, body)
	if err != nil {
		return nil, fmt.Errorf("make the request %s %s: %w", method, path, err)
	}
	request.Header.Set("Authorization", "Bearer "+found.Value)
	response, err := c.http.Do(request)
	if err != nil {
		return nil, fmt.Errorf("call the API with %s %s: %w", method, path, err)
	}
	if response.StatusCode == http.StatusUnauthorized {
		response.Body.Close()
		return nil, found.Refused()
	}
	return response, nil
}
