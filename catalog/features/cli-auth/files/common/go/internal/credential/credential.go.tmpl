package credential

import (
	"context"
	"errors"
	"fmt"
	"os"
)

const (
	name                = "{{ kebab .Name }}"
	environmentVariable = "{{ upper (snake .Name) }}_API_KEY"
)

var ErrMissing = errors.New("no API key")

type Credential struct {
	Value  string
	Source string
}

func Resolve(ctx context.Context) (Credential, error) {
	if value := os.Getenv(environmentVariable); value != "" {
		return Credential{Value: value, Source: environmentVariable}, nil
	}
	path, err := configPath()
	if err != nil {
		return Credential{}, err
	}
	command, err := credentialCommand(path)
	if err != nil {
		return Credential{}, err
	}
	if command != "" {
		return runCommand(ctx, command, path)
	}
	return Credential{}, fmt.Errorf(`%w: set %s, or set credentialCommand in %s`, ErrMissing, environmentVariable, path)
}
