package credential

import (
	"context"
	"errors"
	"fmt"
	"os"
	"time"
)

const (
	name                = "{{ kebab .Name }}"
	environmentVariable = "{{ upper (snake .Name) }}_TOKEN"
)

var (
	ErrMissing = errors.New("no token")
	ErrRefused = errors.New("the API refused the token")
)

type Credential struct {
	Value   string
	Source  string
	Account string
	Expiry  time.Time
}

func Resolve(ctx context.Context) (Credential, error) {
	if value := os.Getenv(environmentVariable); value != "" {
		return Credential{Value: value, Source: environmentVariable}, nil
	}
	stored, err := storedTokens(ctx)
	if err == nil {
		return stored, nil
	}
	if !errors.Is(err, ErrNotStored) {
		return Credential{}, err
	}
	path, err := configPath()
	if err != nil {
		return Credential{}, err
	}
	command, err := credentialCommand(path)
	if err != nil {
		return Credential{}, err
	}
	if command != "" {
		return runCommand(ctx, command, path)
	}
	return Credential{}, fmt.Errorf(`%w: run "%s auth login", set %s, or set credentialCommand in %s`, ErrMissing, name, environmentVariable, path)
}

func (c Credential) Refused() error {
	return fmt.Errorf(`%w from %s: run "%s auth login", or give a token for the audience of the API`, ErrRefused, c.Source, name)
}
