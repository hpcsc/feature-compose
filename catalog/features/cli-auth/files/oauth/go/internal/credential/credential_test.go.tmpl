//go:build unit

package credential_test

import (
	"os"
	"path/filepath"
	"testing"

	"{{ option "starter.module" }}/internal/credential"
	"github.com/stretchr/testify/require"
)

func isolate(t *testing.T) string {
	t.Helper()
	home := t.TempDir()
	t.Setenv("XDG_CONFIG_HOME", home)
	t.Setenv("{{ upper (snake .Name) }}_TOKEN", "")
	t.Setenv("{{ upper (snake .Name) }}_API_URL", "https://api.example.test")
	t.Setenv("{{ upper (snake .Name) }}_CREDENTIAL_STORE", "file")
	t.Setenv("{{ upper (snake .Name) }}_OAUTH_ISSUER_URL", "")
	t.Setenv("{{ upper (snake .Name) }}_OAUTH_CLIENT_ID", "")
	t.Setenv("{{ upper (snake .Name) }}_OAUTH_AUDIENCE", "")
	return filepath.Join(home, "{{ kebab .Name }}")
}

func writeConfig(t *testing.T, dir, text string) string {
	t.Helper()
	require.NoError(t, os.MkdirAll(dir, 0o700))
	path := filepath.Join(dir, "config.yaml")
	require.NoError(t, os.WriteFile(path, []byte(text), 0o600))
	return path
}

func TestCredential(t *testing.T) {
	t.Run("resolve", func(t *testing.T) {
		t.Run("takes the token from {{ upper (snake .Name) }}_TOKEN before the credentialCommand", func(t *testing.T) {
			writeConfig(t, isolate(t), "credentialCommand: echo from-command\n")
			t.Setenv("{{ upper (snake .Name) }}_TOKEN", "from-environment")

			found, err := credential.Resolve(t.Context())

			require.NoError(t, err)
			require.Equal(t, "from-environment", found.Value)
			require.Equal(t, "{{ upper (snake .Name) }}_TOKEN", found.Source)
		})

		t.Run("runs the credentialCommand in the user config when the environment has no token", func(t *testing.T) {
			path := writeConfig(t, isolate(t), "credentialCommand: echo from-command\n")

			found, err := credential.Resolve(t.Context())

			require.NoError(t, err)
			require.Equal(t, "from-command", found.Value)
			require.Equal(t, "the credentialCommand in "+path, found.Source)
		})

		t.Run("ignores the other keys in the user config", func(t *testing.T) {
			writeConfig(t, isolate(t), "theme: dark\ncredentialCommand: echo from-command\n")

			found, err := credential.Resolve(t.Context())

			require.NoError(t, err)
			require.Equal(t, "from-command", found.Value)
		})

		t.Run("a credentialCommand that fails is an error that names the config file", func(t *testing.T) {
			path := writeConfig(t, isolate(t), "credentialCommand: exit 3\n")

			_, err := credential.Resolve(t.Context())

			require.ErrorContains(t, err, "run the credentialCommand in "+path)
		})

		t.Run("a credentialCommand that prints nothing is an error", func(t *testing.T) {
			writeConfig(t, isolate(t), "credentialCommand: printf ''\n")

			_, err := credential.Resolve(t.Context())

			require.ErrorContains(t, err, "printed no token")
		})

		t.Run("with no source, the error says how to give the token", func(t *testing.T) {
			dir := isolate(t)

			_, err := credential.Resolve(t.Context())

			require.ErrorIs(t, err, credential.ErrMissing)
			require.ErrorContains(t, err, "{{ upper (snake .Name) }}_TOKEN")
			require.ErrorContains(t, err, filepath.Join(dir, "config.yaml"))
			require.ErrorContains(t, err, `"{{ kebab .Name }} auth login"`)
		})
	})
}
