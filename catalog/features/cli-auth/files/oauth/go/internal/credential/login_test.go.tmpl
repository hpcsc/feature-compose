//go:build unit

package credential_test

import (
	"bytes"
	"errors"
	"net/http"
	"net/http/httptest"
	"path/filepath"
	"strings"
	"testing"
	"time"

	"{{ option "starter.module" }}/internal/credential"
	"github.com/stretchr/testify/require"
)

func isolateWithIssuer(t *testing.T, issuer *testIssuer) string {
	t.Helper()
	dir := isolate(t)
	t.Setenv("{{ upper (snake .Name) }}_OAUTH_ISSUER_URL", issuer.URL())
	t.Setenv("{{ upper (snake .Name) }}_OAUTH_CLIENT_ID", testClientID)
	t.Setenv("{{ upper (snake .Name) }}_OAUTH_AUDIENCE", testAudience)
	return dir
}

func browse(address string) error {
	response, err := http.Get(address)
	if err != nil {
		return err
	}
	return response.Body.Close()
}

func loginInBrowser(t *testing.T) credential.Tokens {
	t.Helper()
	tokens, _, err := credential.Login(t.Context(), credential.LoginOptions{Out: &bytes.Buffer{}, Open: browse})
	require.NoError(t, err)
	return tokens
}

func TestLogin(t *testing.T) {
	t.Run("browser", func(t *testing.T) {
		t.Run("stores the tokens after the issuer checks the PKCE code verifier", func(t *testing.T) {
			issuer := newTestIssuer(t)
			dir := isolateWithIssuer(t, issuer)

			tokens, source, err := credential.Login(t.Context(), credential.LoginOptions{Out: &bytes.Buffer{}, Open: browse})

			require.NoError(t, err)
			require.Equal(t, "ada@example.com", tokens.Account)
			require.Equal(t, filepath.Join(dir, "credentials.json"), source)
			issuer.read(func(i *testIssuer) { require.Equal(t, 1, i.verifiedLogins) })
			found, err := credential.Resolve(t.Context())
			require.NoError(t, err)
			require.Equal(t, issuer.accessToken(1), found.Value)
		})

		t.Run("asks the issuer for a token for the audience of the API, with the scopes of OpenID Connect and offline_access", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)

			loginInBrowser(t)

			issuer.read(func(i *testIssuer) {
				require.Equal(t, []loginRequest{
					{scope: "openid profile email offline_access", audience: testAudience},
				}, i.logins)
			})
		})

		t.Run("the API of the repo accepts the access token that the login stores", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			api := startedAPI(t, issuer, testAudience)
			t.Setenv("{{ upper (snake .Name) }}_API_URL", api.url)
			loginInBrowser(t)

			answer, err := api.call(t)

			require.NoError(t, err)
			require.Equal(t, "the answer of the handler", answer)
		})

		t.Run("prints the URL, so that a person can open it when the browser does not open", func(t *testing.T) {
			isolateWithIssuer(t, newTestIssuer(t))
			var out bytes.Buffer
			person := func(address string) error {
				go func() { _ = browse(address) }()
				return errors.New("no browser")
			}

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Out: &out, Open: person})

			require.NoError(t, err)
			require.Contains(t, out.String(), "/authorize?")
			require.Contains(t, out.String(), "The browser did not open: no browser")
		})

		t.Run("rejects a response with another state", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.otherState = true })

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Out: &bytes.Buffer{}, Open: browse})

			require.ErrorContains(t, err, "different state")
		})

		t.Run("reports a login that the issuer refuses", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.refusesLogin = true })

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Out: &bytes.Buffer{}, Open: browse})

			require.ErrorContains(t, err, "access_denied")
		})

		t.Run("stops at an answer with no code and no error", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.sendsNoCode = true })

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Out: &bytes.Buffer{}, Open: browse})

			require.ErrorContains(t, err, "the login response has no code")
			issuer.read(func(i *testIssuer) { require.Equal(t, 0, i.verifiedLogins) })
		})

		t.Run("a browser that does not return does not stop the login", func(t *testing.T) {
			isolateWithIssuer(t, newTestIssuer(t))
			stays := make(chan struct{})
			t.Cleanup(func() { close(stays) })
			staysOpen := func(address string) error {
				go func() { _ = browse(address) }()
				<-stays
				return nil
			}

			loggedIn := make(chan error, 1)
			go func() {
				_, _, err := credential.Login(t.Context(), credential.LoginOptions{Out: &bytes.Buffer{}, Open: staysOpen})
				loggedIn <- err
			}()

			select {
			case err := <-loggedIn:
				require.NoError(t, err)
			case <-time.After(10 * time.Second):
				require.Fail(t, "the login waits for the browser to return")
			}
		})
	})

	t.Run("device", func(t *testing.T) {
		t.Run("prints the code to enter and stores the tokens", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			var out bytes.Buffer

			tokens, _, err := credential.Login(t.Context(), credential.LoginOptions{Device: true, Out: &out})

			require.NoError(t, err)
			require.Equal(t, "ada@example.com", tokens.Account)
			require.Contains(t, out.String(), issuer.URL()+"/activate")
			require.Contains(t, out.String(), "ABCD-EFGH")
			found, err := credential.Resolve(t.Context())
			require.NoError(t, err)
			require.Equal(t, issuer.accessToken(1), found.Value)
		})

		t.Run("asks the issuer for a token for the audience of the API, with the scopes of OpenID Connect and offline_access", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Device: true, Out: &bytes.Buffer{}})

			require.NoError(t, err)
			issuer.read(func(i *testIssuer) {
				require.Equal(t, []loginRequest{
					{scope: "openid profile email offline_access", audience: testAudience},
				}, i.logins)
			})
		})

		t.Run("the API of the repo accepts the access token that the login stores", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			api := startedAPI(t, issuer, testAudience)
			t.Setenv("{{ upper (snake .Name) }}_API_URL", api.url)
			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Device: true, Out: &bytes.Buffer{}})
			require.NoError(t, err)

			answer, err := api.call(t)

			require.NoError(t, err)
			require.Equal(t, "the answer of the handler", answer)
		})

		t.Run("fails when the issuer has no device authorization endpoint", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.noDevice = true })

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Device: true, Out: &bytes.Buffer{}})

			require.ErrorContains(t, err, "has no device_authorization_endpoint")
		})
	})

	t.Run("settings", func(t *testing.T) {
		t.Run("without the settings of the OAuth client, the error names each constant and its variable", func(t *testing.T) {
			isolate(t)

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Out: &bytes.Buffer{}, Open: browse})

			require.ErrorContains(t, err, "set issuerURL, clientID and audience in internal/credential/oauth_setting.go, or set {{ upper (snake .Name) }}_OAUTH_ISSUER_URL, {{ upper (snake .Name) }}_OAUTH_CLIENT_ID and {{ upper (snake .Name) }}_OAUTH_AUDIENCE")
		})

		for constant, variable := range map[string]string{
			"issuerURL": "{{ upper (snake .Name) }}_OAUTH_ISSUER_URL",
			"clientID":  "{{ upper (snake .Name) }}_OAUTH_CLIENT_ID",
			"audience":  "{{ upper (snake .Name) }}_OAUTH_AUDIENCE",
		} {
			t.Run("without "+constant+", the login sends no request, and the error names only "+constant+" and its variable", func(t *testing.T) {
				issuer := newTestIssuer(t)
				isolateWithIssuer(t, issuer)
				t.Setenv(variable, "")

				for _, options := range []credential.LoginOptions{
					{Out: &bytes.Buffer{}, Open: browse},
					{Device: true, Out: &bytes.Buffer{}},
				} {
					_, _, err := credential.Login(t.Context(), options)

					require.ErrorContains(t, err, "the OAuth client is not set: set "+constant+" in internal/credential/oauth_setting.go, or set "+variable)
				}
				issuer.read(func(i *testIssuer) { require.Equal(t, 0, i.requests) })
			})
		}

		for _, issuerURL := range []string{"http://issuer.example.test", "issuer.example.test", "ftp://127.0.0.1"} {
			t.Run("rejects the issuer URL "+issuerURL+", which is not https or http of a loopback host, and names issuerURL and its variable", func(t *testing.T) {
				isolateWithIssuer(t, newTestIssuer(t))
				t.Setenv("{{ upper (snake .Name) }}_OAUTH_ISSUER_URL", issuerURL)

				_, _, err := credential.Login(t.Context(), credential.LoginOptions{Device: true, Out: &bytes.Buffer{}})

				require.ErrorContains(t, err, `issuerURL "`+issuerURL+`" must be an absolute https URL, or an http URL of a loopback host`)
				require.ErrorContains(t, err, "set issuerURL in internal/credential/oauth_setting.go, or set {{ upper (snake .Name) }}_OAUTH_ISSUER_URL")
			})
		}

		t.Run("accepts an https issuer URL, and asks it for its discovery", func(t *testing.T) {
			isolateWithIssuer(t, newTestIssuer(t))
			withTLS := httptest.NewTLSServer(http.NotFoundHandler())
			t.Cleanup(withTLS.Close)
			t.Setenv("{{ upper (snake .Name) }}_OAUTH_ISSUER_URL", withTLS.URL+"/realms/my-service")

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Device: true, Out: &bytes.Buffer{}})

			require.ErrorContains(t, err, "discover the OAuth endpoints of "+withTLS.URL+"/realms/my-service")
			require.NotContains(t, err.Error(), "must be an absolute https URL")
		})

		t.Run("accepts an http issuer URL of localhost", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			t.Setenv("{{ upper (snake .Name) }}_OAUTH_ISSUER_URL", strings.Replace(issuer.URL(), "127.0.0.1", "localhost", 1))

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Device: true, Out: &bytes.Buffer{}})

			require.ErrorContains(t, err, "names another issuer")
		})

		t.Run("rejects a discovery document that names another issuer", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.otherIssuer = true })

			_, _, err := credential.Login(t.Context(), credential.LoginOptions{Out: &bytes.Buffer{}, Open: browse})

			require.ErrorContains(t, err, "names another issuer")
		})
	})
}
