package credential

import (
	"fmt"
	"net"
	"net/url"
	"strings"
)

const (
	issuerURL         = ""
	clientID          = ""
	audience          = ""
	issuerURLVariable = "{{ upper (snake .Name) }}_OAUTH_ISSUER_URL"
	clientIDVariable  = "{{ upper (snake .Name) }}_OAUTH_CLIENT_ID"
	audienceVariable  = "{{ upper (snake .Name) }}_OAUTH_AUDIENCE"
)

type oauthSetting struct {
	constantName string
	variable     string
	value        string
}

func issuerURLSetting() oauthSetting {
	return oauthSetting{constantName: "issuerURL", variable: issuerURLVariable, value: strings.TrimSuffix(setting(issuerURLVariable, issuerURL), "/")}
}

func clientIDSetting() oauthSetting {
	return oauthSetting{constantName: "clientID", variable: clientIDVariable, value: setting(clientIDVariable, clientID)}
}

func audienceSetting() oauthSetting {
	return oauthSetting{constantName: "audience", variable: audienceVariable, value: setting(audienceVariable, audience)}
}

func (s oauthSetting) checkSecureURL() error {
	parsed, err := url.Parse(s.value)
	if err != nil || parsed.Host == "" || !(parsed.Scheme == "https" || parsed.Scheme == "http" && isLoopback(parsed.Hostname())) {
		return fmt.Errorf("%s %q must be an absolute https URL, or an http URL of a loopback host such as http://127.0.0.1:8080: set %s in internal/credential/oauth_setting.go, or set %s", s.constantName, s.value, s.constantName, s.variable)
	}
	return nil
}

func notSet(settings ...oauthSetting) error {
	var constantNames, variables []string
	for _, s := range settings {
		if s.value == "" {
			constantNames = append(constantNames, s.constantName)
			variables = append(variables, s.variable)
		}
	}
	if len(constantNames) == 0 {
		return nil
	}
	return fmt.Errorf("the OAuth client is not set: set %s in internal/credential/oauth_setting.go, or set %s", inWords(constantNames), inWords(variables))
}

func isLoopback(host string) bool {
	ip := net.ParseIP(host)
	return host == "localhost" || ip != nil && ip.IsLoopback()
}

func inWords(names []string) string {
	if len(names) == 1 {
		return names[0]
	}
	return strings.Join(names[:len(names)-1], ", ") + " and " + names[len(names)-1]
}
