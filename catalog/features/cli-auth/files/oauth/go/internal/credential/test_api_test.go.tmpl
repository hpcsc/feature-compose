//go:build unit

package credential_test

import (
	"io"
	"net/http"
	"net/http/httptest"
	"testing"

	"{{ option "starter.module" }}/internal/apiclient"
	"{{ option "starter.module" }}/internal/auth"
	"github.com/stretchr/testify/require"
)

type testAPI struct {
	url string
}

func startedAPI(t *testing.T, issuer *testIssuer, audience string) testAPI {
	t.Helper()
	protected := auth.Middleware(auth.Config{IssuerURL: auth.IssuerURL(issuer.URL()), Audience: audience})(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		_, _ = io.WriteString(w, "the answer of the handler")
	}))
	server := httptest.NewServer(protected)
	t.Cleanup(server.Close)
	return testAPI{url: server.URL}
}

func (a testAPI) call(t *testing.T) (string, error) {
	t.Helper()
	response, err := apiclient.New(a.url).Do(t.Context(), http.MethodGet, "/accounts/1", nil)
	if err != nil {
		return "", err
	}
	defer response.Body.Close()
	body, err := io.ReadAll(response.Body)
	require.NoError(t, err)
	return string(body), nil
}
