//go:build unit

package credential_test

import (
	"crypto"
	"crypto/rand"
	"crypto/rsa"
	"crypto/sha256"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"math/big"
	"net/http"
	"net/http/httptest"
	"net/url"
	"sync"
	"testing"
	"time"

	"github.com/stretchr/testify/require"
)

const (
	testClientID = "test-client"
	testAudience = "the-api-of-the-test"
	signingKeyID = "test"
)

type loginRequest struct {
	scope    string
	audience string
}

type testIssuer struct {
	t          *testing.T
	server     *httptest.Server
	signingKey *rsa.PrivateKey

	mu             sync.Mutex
	requests       int
	expiresIn      int
	challenges     map[string]string
	audiences      map[string]string
	logins         []loginRequest
	verifiedLogins int
	issued         []string
	refreshTokens  []string
	revokedTokens  []string
	otherState     bool
	refusesLogin   bool
	sendsNoCode    bool
	refusesRefresh bool
	refusesRevoke  bool
	noDevice       bool
	otherIssuer    bool
	noRefreshToken bool
	noIDToken      bool
}

func newTestIssuer(t *testing.T) *testIssuer {
	t.Helper()
	signingKey, err := rsa.GenerateKey(rand.Reader, 2048)
	require.NoError(t, err)
	i := &testIssuer{t: t, signingKey: signingKey, expiresIn: 3600, challenges: map[string]string{}, audiences: map[string]string{}}
	mux := http.NewServeMux()
	mux.HandleFunc("GET /.well-known/openid-configuration", i.serveDiscovery)
	mux.HandleFunc("GET /signing-keys", i.serveSigningKeys)
	mux.HandleFunc("GET /authorize", i.serveAuthorize)
	mux.HandleFunc("POST /device", i.serveDevice)
	mux.HandleFunc("POST /token", i.serveToken)
	mux.HandleFunc("POST /revoke", i.serveRevoke)
	i.server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		i.change(func(i *testIssuer) { i.requests++ })
		mux.ServeHTTP(w, r)
	}))
	t.Cleanup(i.server.Close)
	return i
}

func (i *testIssuer) URL() string {
	return i.server.URL
}

func (i *testIssuer) change(apply func(*testIssuer)) {
	i.mu.Lock()
	defer i.mu.Unlock()
	apply(i)
}

func (i *testIssuer) read(get func(*testIssuer)) {
	i.mu.Lock()
	defer i.mu.Unlock()
	get(i)
}

func (i *testIssuer) accessToken(n int) string {
	i.mu.Lock()
	defer i.mu.Unlock()
	require.Greater(i.t, len(i.issued), n-1, "the test issuer issued fewer access tokens")
	return i.issued[n-1]
}

func (i *testIssuer) serveDiscovery(w http.ResponseWriter, _ *http.Request) {
	i.mu.Lock()
	defer i.mu.Unlock()
	name := i.server.URL
	if i.otherIssuer {
		name = "https://issuer.example.test"
	}
	document := map[string]string{
		"issuer":                 name,
		"jwks_uri":               i.server.URL + "/signing-keys",
		"authorization_endpoint": i.server.URL + "/authorize",
		"token_endpoint":         i.server.URL + "/token",
		"revocation_endpoint":    i.server.URL + "/revoke",
	}
	if !i.noDevice {
		document["device_authorization_endpoint"] = i.server.URL + "/device"
	}
	writeJSON(w, http.StatusOK, document)
}

func (i *testIssuer) serveSigningKeys(w http.ResponseWriter, _ *http.Request) {
	public := i.signingKey.PublicKey
	writeJSON(w, http.StatusOK, map[string]any{"keys": []map[string]string{
		{
			"kty": "RSA", "kid": signingKeyID, "use": "sig", "alg": "RS256",
			"n": base64.RawURLEncoding.EncodeToString(public.N.Bytes()),
			"e": base64.RawURLEncoding.EncodeToString(big.NewInt(int64(public.E)).Bytes()),
		},
	}})
}

func (i *testIssuer) serveAuthorize(w http.ResponseWriter, r *http.Request) {
	i.mu.Lock()
	defer i.mu.Unlock()
	query := r.URL.Query()
	redirect, err := url.Parse(query.Get("redirect_uri"))
	if err != nil || query.Get("client_id") != testClientID {
		http.Error(w, "an unknown client or redirect URL", http.StatusBadRequest)
		return
	}
	i.logins = append(i.logins, loginRequest{scope: query.Get("scope"), audience: query.Get("audience")})
	values := redirect.Query()
	values.Set("state", query.Get("state"))
	if i.otherState {
		values.Set("state", "another-state")
	}
	switch {
	case query.Get("code_challenge_method") != "S256" || query.Get("code_challenge") == "":
		values.Set("error", "invalid_request")
	case i.refusesLogin:
		values.Set("error", "access_denied")
	case i.sendsNoCode:
	default:
		code := fmt.Sprintf("code-%d", len(i.challenges)+1)
		i.challenges[code] = query.Get("code_challenge")
		i.audiences[code] = query.Get("audience")
		values.Set("code", code)
	}
	redirect.RawQuery = values.Encode()
	http.Redirect(w, r, redirect.String(), http.StatusFound)
}

func (i *testIssuer) serveDevice(w http.ResponseWriter, r *http.Request) {
	i.mu.Lock()
	defer i.mu.Unlock()
	if err := r.ParseForm(); err != nil || r.PostForm.Get("client_id") != testClientID {
		writeJSON(w, http.StatusUnauthorized, map[string]string{"error": "invalid_client"})
		return
	}
	i.logins = append(i.logins, loginRequest{scope: r.PostForm.Get("scope"), audience: r.PostForm.Get("audience")})
	i.audiences["device-1"] = r.PostForm.Get("audience")
	writeJSON(w, http.StatusOK, map[string]any{
		"device_code":      "device-1",
		"user_code":        "ABCD-EFGH",
		"verification_uri": i.server.URL + "/activate",
		"expires_in":       600,
		"interval":         1,
	})
}

func (i *testIssuer) serveToken(w http.ResponseWriter, r *http.Request) {
	i.mu.Lock()
	defer i.mu.Unlock()
	if err := r.ParseForm(); err != nil || r.PostForm.Get("client_id") != testClientID {
		writeJSON(w, http.StatusUnauthorized, map[string]string{"error": "invalid_client"})
		return
	}
	var audience string
	switch r.PostForm.Get("grant_type") {
	case "authorization_code":
		code := r.PostForm.Get("code")
		sum := sha256.Sum256([]byte(r.PostForm.Get("code_verifier")))
		if i.challenges[code] != base64.RawURLEncoding.EncodeToString(sum[:]) {
			writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_grant"})
			return
		}
		i.verifiedLogins++
		audience = i.audiences[code]
	case "urn:ietf:params:oauth:grant-type:device_code":
		if r.PostForm.Get("device_code") != "device-1" {
			writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_grant"})
			return
		}
		audience = i.audiences["device-1"]
	case "refresh_token":
		refreshToken := r.PostForm.Get("refresh_token")
		if i.refusesRefresh || len(i.refreshTokens) == 0 || refreshToken != i.refreshTokens[len(i.refreshTokens)-1] {
			writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid_grant"})
			return
		}
		audience = i.audiences[refreshToken]
	default:
		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "unsupported_grant_type"})
		return
	}
	accessToken := i.token(audience)
	i.issued = append(i.issued, accessToken)
	answer := map[string]any{"access_token": accessToken, "token_type": "Bearer", "expires_in": i.expiresIn}
	if !i.noRefreshToken {
		refreshToken := fmt.Sprintf("refresh-%d", len(i.refreshTokens)+1)
		i.refreshTokens = append(i.refreshTokens, refreshToken)
		i.audiences[refreshToken] = audience
		answer["refresh_token"] = refreshToken
	}
	if !i.noIDToken {
		claims := base64.RawURLEncoding.EncodeToString([]byte(`{"sub":"user-1","email":"ada@example.com"}`))
		answer["id_token"] = "eyJhbGciOiJub25lIn0." + claims + "."
	}
	writeJSON(w, http.StatusOK, answer)
}

func (i *testIssuer) serveRevoke(w http.ResponseWriter, r *http.Request) {
	i.mu.Lock()
	defer i.mu.Unlock()
	if i.refusesRevoke {
		http.Error(w, "the issuer cannot revoke now", http.StatusServiceUnavailable)
		return
	}
	if err := r.ParseForm(); err != nil {
		http.Error(w, err.Error(), http.StatusBadRequest)
		return
	}
	i.revokedTokens = append(i.revokedTokens, r.PostForm.Get("token"))
}

func (i *testIssuer) token(audience string) string {
	claims := map[string]any{"iss": i.server.URL, "sub": "user-1", "exp": time.Now().Add(time.Duration(i.expiresIn) * time.Second).Unix(), "jti": fmt.Sprintf("access-%d", len(i.issued)+1)}
	if audience != "" {
		claims["aud"] = audience
	}
	encoded := func(value any) string {
		text, err := json.Marshal(value)
		require.NoError(i.t, err)
		return base64.RawURLEncoding.EncodeToString(text)
	}
	content := encoded(map[string]string{"alg": "RS256", "typ": "JWT", "kid": signingKeyID}) + "." + encoded(claims)
	sum := sha256.Sum256([]byte(content))
	signature, err := rsa.SignPKCS1v15(rand.Reader, i.signingKey, crypto.SHA256, sum[:])
	require.NoError(i.t, err)
	return content + "." + base64.RawURLEncoding.EncodeToString(signature)
}

func writeJSON(w http.ResponseWriter, status int, body any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(body)
}
