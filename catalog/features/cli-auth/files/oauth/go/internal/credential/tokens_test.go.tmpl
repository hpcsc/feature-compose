//go:build unit

package credential_test

import (
	"bytes"
	"path/filepath"
	"testing"

	"{{ option "starter.module" }}/internal/credential"
	"github.com/stretchr/testify/require"
)

func TestTokens(t *testing.T) {
	t.Run("resolve", func(t *testing.T) {
		t.Run("takes the stored token before the credentialCommand", func(t *testing.T) {
			issuer := newTestIssuer(t)
			dir := isolateWithIssuer(t, issuer)
			writeConfig(t, dir, "credentialCommand: echo from-command\n")
			loginInBrowser(t)

			found, err := credential.Resolve(t.Context())

			require.NoError(t, err)
			require.Equal(t, issuer.accessToken(1), found.Value)
			require.Equal(t, filepath.Join(dir, "credentials.json"), found.Source)
			require.Equal(t, "ada@example.com", found.Account)
		})

		t.Run("takes {{ upper (snake .Name) }}_TOKEN before the stored token", func(t *testing.T) {
			isolateWithIssuer(t, newTestIssuer(t))
			loginInBrowser(t)
			t.Setenv("{{ upper (snake .Name) }}_TOKEN", "from-environment")

			found, err := credential.Resolve(t.Context())

			require.NoError(t, err)
			require.Equal(t, "from-environment", found.Value)
		})

		t.Run("does not give a token that is stored for another API host", func(t *testing.T) {
			isolateWithIssuer(t, newTestIssuer(t))
			loginInBrowser(t)
			t.Setenv("{{ upper (snake .Name) }}_API_URL", "https://other.example.test")

			_, err := credential.Resolve(t.Context())

			require.ErrorIs(t, err, credential.ErrMissing)
		})
	})

	t.Run("refresh", func(t *testing.T) {
		t.Run("gets a new access token when the stored one expires, and stores it", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.expiresIn = 1 })
			loginInBrowser(t)
			issuer.change(func(i *testIssuer) { i.expiresIn = 3600 })

			refreshed, err := credential.Resolve(t.Context())
			require.NoError(t, err)
			again, err := credential.Resolve(t.Context())
			require.NoError(t, err)

			require.Equal(t, issuer.accessToken(2), refreshed.Value)
			require.Equal(t, issuer.accessToken(2), again.Value)
		})

		t.Run("the API of the repo accepts the access token of a refresh", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			api := startedAPI(t, issuer, testAudience)
			t.Setenv("{{ upper (snake .Name) }}_API_URL", api.url)
			issuer.change(func(i *testIssuer) { i.expiresIn = 1 })
			loginInBrowser(t)
			issuer.change(func(i *testIssuer) { i.expiresIn = 3600 })

			answer, err := api.call(t)

			require.NoError(t, err)
			require.Equal(t, "the answer of the handler", answer)
			issuer.read(func(i *testIssuer) { require.Len(t, i.issued, 2) })
		})

		t.Run("keeps the refresh token when the issuer sends no new one, and uses it for the next refresh", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.expiresIn = 1 })
			loginInBrowser(t)
			issuer.change(func(i *testIssuer) { i.noRefreshToken = true })
			_, err := credential.Resolve(t.Context())
			require.NoError(t, err)

			found, err := credential.Resolve(t.Context())

			require.NoError(t, err)
			require.Equal(t, issuer.accessToken(3), found.Value)
		})

		t.Run("keeps the account when the issuer sends no new ID token", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.expiresIn = 1 })
			loginInBrowser(t)
			issuer.change(func(i *testIssuer) {
				i.expiresIn = 3600
				i.noIDToken = true
			})

			found, err := credential.Resolve(t.Context())

			require.NoError(t, err)
			require.Equal(t, issuer.accessToken(2), found.Value)
			require.Equal(t, "ada@example.com", found.Account)
		})

		t.Run("asks for a new login when the issuer refuses the refresh", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.expiresIn = 1 })
			loginInBrowser(t)
			issuer.change(func(i *testIssuer) { i.refusesRefresh = true })

			_, err := credential.Resolve(t.Context())

			require.ErrorContains(t, err, `run "{{ kebab .Name }} auth login"`)
		})

		t.Run("asks for a new login when the expired tokens have no refresh token", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) {
				i.expiresIn = 1
				i.noRefreshToken = true
			})
			loginInBrowser(t)

			_, err := credential.Resolve(t.Context())

			require.ErrorContains(t, err, `the tokens for api.example.test expired: run "{{ kebab .Name }} auth login"`)
			issuer.read(func(i *testIssuer) { require.Len(t, i.issued, 1) })
		})
	})

	t.Run("logout", func(t *testing.T) {
		t.Run("revokes the refresh token and removes the tokens", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			loginInBrowser(t)

			removed, err := credential.Logout(t.Context(), &bytes.Buffer{})

			require.NoError(t, err)
			require.True(t, removed)
			issuer.read(func(i *testIssuer) { require.Equal(t, []string{"refresh-1"}, i.revokedTokens) })
			_, err = credential.Resolve(t.Context())
			require.ErrorIs(t, err, credential.ErrMissing)
		})

		t.Run("revokes the access token when the tokens have no refresh token", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			issuer.change(func(i *testIssuer) { i.noRefreshToken = true })
			loginInBrowser(t)

			removed, err := credential.Logout(t.Context(), &bytes.Buffer{})

			require.NoError(t, err)
			require.True(t, removed)
			issuer.read(func(i *testIssuer) { require.Equal(t, []string{i.issued[0]}, i.revokedTokens) })
		})

		t.Run("removes the tokens when the issuer cannot revoke them", func(t *testing.T) {
			issuer := newTestIssuer(t)
			isolateWithIssuer(t, issuer)
			loginInBrowser(t)
			issuer.change(func(i *testIssuer) { i.refusesRevoke = true })
			var warnings bytes.Buffer

			removed, err := credential.Logout(t.Context(), &warnings)

			require.NoError(t, err)
			require.True(t, removed)
			require.Contains(t, warnings.String(), "The issuer did not revoke the token")
			_, err = credential.Resolve(t.Context())
			require.ErrorIs(t, err, credential.ErrMissing)
		})

		t.Run("reports false when nobody is logged in", func(t *testing.T) {
			isolateWithIssuer(t, newTestIssuer(t))

			removed, err := credential.Logout(t.Context(), &bytes.Buffer{})

			require.NoError(t, err)
			require.False(t, removed)
		})
	})
}
