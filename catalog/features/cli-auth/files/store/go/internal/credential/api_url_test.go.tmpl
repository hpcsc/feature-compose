//go:build unit

package credential_test

import (
	"testing"

	"{{ option "starter.module" }}/internal/credential"
	"github.com/stretchr/testify/require"
)

func TestAPIURL(t *testing.T) {
	t.Run("read", func(t *testing.T) {
		t.Run("the variable gives the API URL, and its host", func(t *testing.T) {
			t.Setenv("{{ upper (snake .Name) }}_API_URL", "https://api.example.test/api")

			parsed, err := credential.APIURL()
			require.NoError(t, err)
			host, err := credential.APIHost()
			require.NoError(t, err)

			require.Equal(t, []string{"https://api.example.test/api", "api.example.test"}, []string{parsed.String(), host})
		})

		t.Run("with no API URL, the error names apiURL and its variable", func(t *testing.T) {
			t.Setenv("{{ upper (snake .Name) }}_API_URL", "")

			_, err := credential.APIHost()

			require.ErrorContains(t, err, "the API URL is not set: set apiURL in internal/credential/api_url.go, or set {{ upper (snake .Name) }}_API_URL")
		})

		t.Run("an API URL with no host is an error", func(t *testing.T) {
			t.Setenv("{{ upper (snake .Name) }}_API_URL", "api.example.test/api")

			_, err := credential.APIHost()

			require.ErrorContains(t, err, `the API URL "api.example.test/api" has no host`)
		})
	})
}
