package cli

import (
	"context"
	"fmt"
	"os"

	"github.com/fatih/color"
	"{{ option "starter.module" }}/internal/cli/version"
	"github.com/urfave/cli/v3"
)

const releaseRepository = "{{ githubRepository (option "starter.module") }}"

func Run(ctx context.Context) int {
	if err := newCommand().Run(ctx, os.Args); err != nil {
		color.Red(err.Error())
		return 1
	}

	return 0
}

func newCommand() *cli.Command {
	return &cli.Command{
		Name:                  "{{ kebab .Name }}",
		Version:               version.Current(),
		EnableShellCompletion: true,
		Commands: []*cli.Command{
			newVersionCommand(),
			newUpdateCommand(),
{{- range items "cli.commands" }}
			{{ .code }},
{{- end }}
		},
	}
}

func newVersionCommand() *cli.Command {
	return &cli.Command{
		Name:  "version",
		Usage: "print the tag {{ kebab .Name }} was built from, or its commit when it has no tag",
		Action: func(_ context.Context, cmd *cli.Command) error {
			_, err := fmt.Fprintln(cmd.Root().Writer, version.Current())
			return err
		},
	}
}
