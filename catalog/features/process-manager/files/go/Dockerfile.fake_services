FROM golang:{{ option "starter.go-version" }} AS build-env
WORKDIR /build

ARG VERSION=main

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY internal internal
COPY cmd/fake_services cmd/fake_services

RUN --mount=type=cache,target=/go/pkg/mod \
    GOOS=linux \
    CGO_ENABLED=0 \
      go build --ldflags "-extldflags -static -X '{{ option "starter.module" }}/internal/api/use_cases/root.Version=${VERSION}'" \
        -o fake_services \
        ./cmd/fake_services

FROM gcr.io/distroless/static
WORKDIR /app

COPY --from=build-env /build/fake_services .

ENTRYPOINT ["/app/fake_services"]
