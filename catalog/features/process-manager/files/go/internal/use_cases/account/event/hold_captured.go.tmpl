package event

import (
	"github.com/google/uuid"
	domainEvent "{{ option "starter.module" }}/internal/domain/event"
)

type HoldCaptured struct {
	AccountID uuid.UUID `json:"accountId"`
	PaymentID uuid.UUID `json:"paymentId"`
	Amount    int64     `json:"amount"`
}

func (HoldCaptured) EventType() string {
	return domainEvent.Namespace + ".hold-captured"
}
