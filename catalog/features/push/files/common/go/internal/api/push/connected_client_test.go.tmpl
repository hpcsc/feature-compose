package push_test

import (
	"context"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"time"

	"github.com/coder/websocket"
	"{{ option "starter.module" }}/internal/api/push"
	apiTest "{{ option "starter.module" }}/internal/api/test"
	"github.com/stretchr/testify/require"
)

const (
	probeType     = "probe"
	allowedOrigin = "https://app.example.com"
)

type connectedClient struct {
	connection *websocket.Conn
	messages   chan string
	closed     chan websocket.StatusCode
}

func connected(t *testing.T, clients *push.Clients, url string) *connectedClient {
	t.Helper()
	return connectedFrom(t, clients, url, "")
}

func connectedFrom(t *testing.T, clients *push.Clients, url string, origin string) *connectedClient {
	t.Helper()
	dialCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	options := &websocket.DialOptions{HTTPHeader: http.Header{}}
	if origin != "" {
		options.HTTPHeader.Set("Origin", origin)
	}
	connection, _, err := websocket.Dial(dialCtx, url, options)
	require.NoError(t, err)
	t.Cleanup(func() { _ = connection.CloseNow() })
	client := &connectedClient{connection: connection, messages: make(chan string, 100), closed: make(chan websocket.StatusCode, 1)}
	go client.read()

	deadline := time.After(5 * time.Second)
	for {
		clients.Send(context.Background(), push.Message{Type: probeType})
		select {
		case <-client.messages:
			return client
		case <-time.After(20 * time.Millisecond):
		case <-deadline:
			require.FailNow(t, "the client got no message within 5 seconds of its connection")
		}
	}
}

func (c *connectedClient) read() {
	for {
		_, data, err := c.connection.Read(context.Background())
		if err != nil {
			c.closed <- websocket.CloseStatus(err)
			return
		}
		c.messages <- string(data)
	}
}

func (c *connectedClient) next(t *testing.T) string {
	t.Helper()
	deadline := time.After(5 * time.Second)
	for {
		select {
		case message := <-c.messages:
			if !strings.HasPrefix(message, `{"type":"`+probeType+`"`) {
				return message
			}
		case <-deadline:
			require.FailNow(t, "the client got no message within 5 seconds")
			return ""
		}
	}
}

func (c *connectedClient) closedWith(t *testing.T) websocket.StatusCode {
	t.Helper()
	select {
	case status := <-c.closed:
		return status
	case <-time.After(15 * time.Second):
		require.FailNow(t, "the client was not closed within 15 seconds")
		return 0
	}
}

func served(t *testing.T, clients *push.Clients) string {
	t.Helper()
	server := httptest.NewServer(apiTest.NewRouterWithRoutable(push.NewHandler(clients, []string{allowedOrigin}, slog.New(slog.DiscardHandler))))
	t.Cleanup(server.Close)
	return "ws" + strings.TrimPrefix(server.URL, "http") + "/ws"
}
