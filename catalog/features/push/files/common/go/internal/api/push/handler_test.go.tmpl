//go:build unit

package push_test

import (
	"context"
	"log/slog"
	"net/http"
	"strings"
	"testing"

	"github.com/coder/websocket"
	"{{ option "starter.module" }}/internal/api/push"
	"github.com/stretchr/testify/require"
)

func TestHandler(t *testing.T) {
	t.Run("connect", func(t *testing.T) {
		t.Run("a page of an allowed origin connects to the route /ws and gets the messages", func(t *testing.T) {
			clients := push.NewClients(slog.New(slog.DiscardHandler))
			client := connectedFrom(t, clients, served(t, clients), allowedOrigin)

			clients.Send(context.Background(), push.Message{Type: "my-service.account-opened", Data: map[string]any{"accountId": "a1", "owner": "alice"}})

			require.JSONEq(t, `{"type": "my-service.account-opened", "data": {"accountId": "a1", "owner": "alice"}}`, client.next(t))
		})

		t.Run("a page of the origin of the API connects to the route /ws", func(t *testing.T) {
			clients := push.NewClients(slog.New(slog.DiscardHandler))
			url := served(t, clients)
			client := connectedFrom(t, clients, url, "http://"+strings.TrimSuffix(strings.TrimPrefix(url, "ws://"), "/ws"))

			clients.Send(context.Background(), push.Message{Type: "my-service.account-opened", Data: map[string]any{"accountId": "a1", "owner": "alice"}})

			require.JSONEq(t, `{"type": "my-service.account-opened", "data": {"accountId": "a1", "owner": "alice"}}`, client.next(t))
		})

		for name, origin := range map[string]string{
			"another site":                    "https://another-site.example",
			"the http scheme of the same host": "http://app.example.com",
		} {
			t.Run("a page of "+name+" gets 403 and no connection", func(t *testing.T) {
				clients := push.NewClients(slog.New(slog.DiscardHandler))

				_, response, err := websocket.Dial(context.Background(), served(t, clients), &websocket.DialOptions{HTTPHeader: http.Header{"Origin": {origin}}})

				require.Error(t, err)
				require.Equal(t, http.StatusForbidden, response.StatusCode)
			})
		}
	})
}
