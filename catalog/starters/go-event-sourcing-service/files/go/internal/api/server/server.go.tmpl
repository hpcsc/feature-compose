package server

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"sync"
	"time"

	"github.com/go-chi/chi/v5"
	"github.com/go-chi/chi/v5/middleware"
	"{{ option "starter.module" }}/internal/api"
	apiMiddleware "{{ option "starter.module" }}/internal/api/middleware"
	"{{ option "starter.module" }}/internal/api/middleware/request"
	"{{ option "starter.module" }}/internal/api/use_cases"
{{- range unique "import" "api.middleware" }}
	"{{ option "starter.module" }}/{{ . }}"
{{- end }}
	"github.com/jackc/pgx/v5/pgxpool"
)

func New(name string, cfg *api.Config, pool *pgxpool.Pool, logger *slog.Logger) *Server {
	handler, workers := newHandler(name, cfg, pool, logger)
	return newServer(&http.Server{
		Addr:    fmt.Sprintf(":%s", cfg.Port),
		Handler: handler,
	}, workers, logger)
}

func newServer(httpServer *http.Server, workers []api.Worker, logger *slog.Logger) *Server {
	workersCtx, stopWorkers := context.WithCancel(context.Background())
	return &Server{
		httpServer:     httpServer,
		workers:        workers,
		logger:         logger,
		workersCtx:     workersCtx,
		stopWorkers:    stopWorkers,
		workersStopped: make(chan struct{}),
		failures:       make(chan error, len(workers)+1),
	}
}

func newHandler(name string, cfg *api.Config, pool *pgxpool.Pool, logger *slog.Logger) (http.Handler, []api.Worker) {
	r := chi.NewRouter()

	r.Use(apiMiddleware.RequestLogger(logger, request.NewRealClock(), nil))

	r.Use(middleware.Recoverer)

	r.Use(apiMiddleware.CORS(cfg.AllowedOrigins))

	workers := use_cases.Register(r, protectedMiddleware(cfg), cfg, pool, logger)

	return r, workers
}

func protectedMiddleware(cfg *api.Config) []func(http.Handler) http.Handler {
	return []func(http.Handler) http.Handler{
{{- range items "api.middleware" }}
		{{ .code }},
{{- end }}
	}
}

type Server struct {
	httpServer *http.Server
	workers    []api.Worker
	logger     *slog.Logger

	workersCtx     context.Context
	stopWorkers    context.CancelFunc
	workersStopped chan struct{}
	failures       chan error
}

func (s *Server) Start() error {
	var running sync.WaitGroup
	for _, w := range s.workers {
		running.Add(1)
		go func() {
			defer running.Done()
			defer func() {
				if r := recover(); r != nil {
					s.fail(fmt.Errorf("%s received unhandled error: %v", w.Name(), r))
				}
			}()
			s.run(w)
		}()
	}

	s.logger.Info(fmt.Sprintf("listening at %v", s.httpServer.Addr))
	if err := s.httpServer.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
		s.failures <- fmt.Errorf("failed to start server: %w", err)
		s.stopWorkers()
	}

	running.Wait()
	close(s.workersStopped)

	select {
	case err := <-s.failures:
		return err
	default:
		return nil
	}
}

func (s *Server) Shutdown() {
	// Shutdown signal with grace period of 30 seconds
	withTimeoutCtx, cancelTimeout := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancelTimeout()

	go func() {
		<-withTimeoutCtx.Done()
		if errors.Is(withTimeoutCtx.Err(), context.DeadlineExceeded) {
			s.logger.Error("graceful shutdown timed out")
		}
	}()

	s.httpServer.SetKeepAlivesEnabled(false)
	if err := s.httpServer.Shutdown(withTimeoutCtx); err != nil {
		s.logger.Error(fmt.Sprintf("failed to gracefully shutdown server: %v", err))
	} else {
		s.logger.Info("server shutdown")
	}

	s.stopWorkers()
	select {
	case <-s.workersStopped:
	case <-withTimeoutCtx.Done():
	}
}

func (s *Server) run(w api.Worker) {
	err := w.Start(s.workersCtx)
	if err == nil && s.workersCtx.Err() == nil {
		err = errors.New("stopped before the API stopped")
	}
	if err != nil {
		s.fail(fmt.Errorf("%s failed: %w", w.Name(), err))
	}
}

func (s *Server) fail(err error) {
	s.failures <- err
	s.stopWorkers()
	if err := s.httpServer.Close(); err != nil {
		s.logger.Error(fmt.Sprintf("failed to close server: %v", err))
	}
}
