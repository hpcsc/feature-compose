package use_cases

import (
	"fmt"
	"log/slog"
	"net/http"

	"github.com/go-chi/chi/v5"
	"{{ option "starter.module" }}/internal/api/route"
	apiAccount "{{ option "starter.module" }}/internal/api/use_cases/account"
	"{{ option "starter.module" }}/internal/api/use_cases/root"
	"{{ option "starter.module" }}/internal/domain/command"
	"{{ option "starter.module" }}/internal/domain/event/registry"
	"{{ option "starter.module" }}/internal/domain/event/stream"
	coreUseCases "{{ option "starter.module" }}/internal/use_cases"
	"{{ option "starter.module" }}/internal/use_cases/account/balance"
	"github.com/jackc/pgx/v5/pgxpool"
)

func Register(router chi.Router, protectedMiddleware []func(http.Handler) http.Handler, pool *pgxpool.Pool, logger *slog.Logger) {
	var publicRoutes, protectedRoutes []*route.Route
	for _, r := range allRoutes(pool) {
		if r.IsPublic() {
			publicRoutes = append(publicRoutes, r)
		} else if r.IsProtected() {
			protectedRoutes = append(protectedRoutes, r)
		}
	}

	router.Route("/api", func(api chi.Router) {
		for _, r := range publicRoutes {
			api.MethodFunc(r.Method, r.Pattern, r.Handler)
			logger.Info(fmt.Sprintf("registered public route %s /api%s", r.Method, r.Pattern))
		}

		api.Group(func(protected chi.Router) {
			protected.Use(protectedMiddleware...)
			for _, r := range protectedRoutes {
				protected.MethodFunc(r.Method, r.Pattern, r.Handler)
				logger.Info(fmt.Sprintf("registered protected route %s /api%s", r.Method, r.Pattern))
			}
		})
	})
}

func allRoutes(pool *pgxpool.Pool) []*route.Route {
	reg := registry.New()
	coreUseCases.RegisterEvents(reg)

	eventStream := stream.NewPostgres(pool, reg)
	bus := command.NewBus(command.WithHistory(eventStream))
	coreUseCases.RegisterHandlers(bus, eventStream)

	routables := []route.Routable{
		root.NewHandler(),
		apiAccount.NewHandler(bus, balance.NewQuery(pool)),
	}

	var routes []*route.Route
	for _, r := range routables {
		routes = append(routes, r.Routes()...)
	}
	return routes
}
