//go:build unit

package use_cases_test

import (
	"log/slog"
	"net/http"
	"net/http/httptest"
	"regexp"
	"strings"
	"testing"

	"github.com/go-chi/chi/v5"
	"{{ option "starter.module" }}/internal/api"
	"{{ option "starter.module" }}/internal/api/use_cases"
	"github.com/stretchr/testify/require"
)

func TestRegister(t *testing.T) {
	refusingRouter := func(t *testing.T) chi.Router {
		t.Helper()
		refuse := func(http.Handler) http.Handler {
			return http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
				w.WriteHeader(http.StatusTeapot)
			})
		}
		router := chi.NewRouter()
		use_cases.Register(router, []func(http.Handler) http.Handler{refuse}, &api.Config{}, nil, slog.New(slog.DiscardHandler))
		return router
	}
	statusOf := func(t *testing.T, router chi.Router, method, pattern string) int {
		t.Helper()
		recorder := httptest.NewRecorder()
		router.ServeHTTP(recorder, httptest.NewRequest(method, regexp.MustCompile(`\{[^}]+\}`).ReplaceAllString(pattern, "x"), nil))
		return recorder.Code
	}
	servedRoutes := func(t *testing.T, router chi.Router) [][2]string {
		t.Helper()
		var routes [][2]string
		require.NoError(t, chi.Walk(router, func(method, pattern string, _ http.Handler, _ ...func(http.Handler) http.Handler) error {
			routes = append(routes, [2]string{method, pattern})
			return nil
		}))
		return routes
	}

	t.Run("routes", func(t *testing.T) {
		t.Run("a request to the public route reaches its handler, and a request to each account route goes through the middleware of the protected routes", func(t *testing.T) {
			router := refusingRouter(t)
			statuses := map[string]int{}

			for _, r := range [][2]string{
				{"GET", "/api/"},
				{"POST", "/api/accounts"},
				{"POST", "/api/accounts/{id}/deposits"},
				{"POST", "/api/accounts/{id}/withdrawals"},
				{"POST", "/api/accounts/{id}/close"},
				{"GET", "/api/accounts/{id}"},
			} {
				statuses[r[0]+" "+r[1]] = statusOf(t, router, r[0], r[1])
			}

			require.Equal(t, map[string]int{
				"GET /api/":                          http.StatusOK,
				"POST /api/accounts":                 http.StatusTeapot,
				"POST /api/accounts/{id}/deposits":    http.StatusTeapot,
				"POST /api/accounts/{id}/withdrawals": http.StatusTeapot,
				"POST /api/accounts/{id}/close":       http.StatusTeapot,
				"GET /api/accounts/{id}":              http.StatusTeapot,
			}, statuses)
		})

		t.Run("each route that Register serves, of the starter or of a feature, is under /api", func(t *testing.T) {
			served := servedRoutes(t, refusingRouter(t))

			require.Subset(t, served, [][2]string{
				{"GET", "/api/"},
				{"POST", "/api/accounts"},
				{"GET", "/api/accounts/{id}"},
			})
			for _, r := range served {
				require.True(t, strings.HasPrefix(r[1], "/api/"), r[1])
			}
		})

		t.Run("a request to the path of each route without /api gets 404 and does not reach the middleware of the protected routes", func(t *testing.T) {
			router := refusingRouter(t)
			served := servedRoutes(t, router)

			require.Subset(t, served, [][2]string{
				{"POST", "/api/accounts"},
			})
			for _, r := range served {
				withoutPrefix := strings.TrimPrefix(r[1], "/api")
				require.Equal(t, http.StatusNotFound, statusOf(t, router, r[0], withoutPrefix), r[0]+" "+withoutPrefix)
			}
		})

		t.Run("with no middleware for the protected routes, a request to a protected route gets to its handler", func(t *testing.T) {
			router := chi.NewRouter()
			use_cases.Register(router, nil, &api.Config{}, nil, slog.New(slog.DiscardHandler))
			recorder := httptest.NewRecorder()

			router.ServeHTTP(recorder, httptest.NewRequest("POST", "/api/accounts", strings.NewReader("{}")))

			require.Equal(t, http.StatusBadRequest, recorder.Code)
		})
	})
}
