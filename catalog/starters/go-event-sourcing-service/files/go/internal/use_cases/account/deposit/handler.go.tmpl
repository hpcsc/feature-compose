package deposit

import (
	"context"

	"{{ option "starter.module" }}/internal/domain"
	"{{ option "starter.module" }}/internal/domain/command"
	"{{ option "starter.module" }}/internal/use_cases/account"
	accountCommand "{{ option "starter.module" }}/internal/use_cases/account/command"
)

func Register(bus *command.Bus, accounts *account.Repository) {
	bus.Register[accountCommand.Deposit](handler{accounts: accounts})
}

type handler struct {
	accounts *account.Repository
}

func (h handler) Handle(ctx context.Context, cmd domain.Command[accountCommand.Deposit]) error {
	a, err := h.accounts.Load(ctx, cmd.Payload.AccountID)
	if err != nil {
		return err
	}
	if err := a.Deposit(cmd.Payload.Amount); err != nil {
		return err
	}
	return h.accounts.Save(ctx, a, cmd.Cause())
}
