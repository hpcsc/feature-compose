package account

import (
	"context"

	"github.com/google/uuid"
	"{{ option "starter.module" }}/internal/domain"
	"{{ option "starter.module" }}/internal/domain/event"
	"{{ option "starter.module" }}/internal/domain/event/store"
)

func NewRepository(stream event.Stream) *Repository {
	return &Repository{
		events: store.New(stream),
	}
}

type Repository struct {
	events *store.OfEvents
}

func (r *Repository) Load(ctx context.Context, id uuid.UUID) (*Account, error) {
	return r.events.Load[Account](ctx, StreamID(id))
}

func (r *Repository) Save(ctx context.Context, a *Account, cause domain.Cause) error {
	return r.events.Save(ctx, StreamID(a.ID()), a, cause)
}
