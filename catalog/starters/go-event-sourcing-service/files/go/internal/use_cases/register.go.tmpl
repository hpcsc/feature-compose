package use_cases

import (
	"{{ option "starter.module" }}/internal/domain/command"
	"{{ option "starter.module" }}/internal/domain/event"
	"{{ option "starter.module" }}/internal/domain/event/registry"
	"{{ option "starter.module" }}/internal/use_cases/account"
	"{{ option "starter.module" }}/internal/use_cases/account/close_account"
	"{{ option "starter.module" }}/internal/use_cases/account/deposit"
	"{{ option "starter.module" }}/internal/use_cases/account/open"
	"{{ option "starter.module" }}/internal/use_cases/account/welcome_bonus"
	"{{ option "starter.module" }}/internal/use_cases/account/withdraw"
)

func RegisterEvents(reg *registry.OfEvents) {
	account.RegisterEvents(reg)
{{- range items "use_cases.events" }}
	{{ .code }}
{{- end }}
}

func RegisterHandlers(bus *command.Bus, stream event.Stream) {
	accounts := account.NewRepository(stream)

	open.Register(bus, accounts)
	deposit.Register(bus, accounts)
	withdraw.Register(bus, accounts)
	welcome_bonus.Register(bus, accounts)
	close_account.Register(bus, accounts)
{{- range items "use_cases.handlers" }}
	{{ .code }}
{{- end }}
}
