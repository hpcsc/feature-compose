{{- $module := pascal (option "starter.app") -}}
defmodule {{ $module }}.Catalog.Book do
  use Ecto.Schema
  import Ecto.Changeset

  schema "books" do
    field :title, :string
    field :author, :string
    has_many :copies, {{ $module }}.Catalog.Copy
    timestamps(type: :utc_datetime)
  end

  def changeset(book, attrs) do
    book
    |> cast(attrs, [:title, :author])
    |> validate_required([:title, :author])
  end
end
